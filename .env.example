# Public, non-secret defaults. setup-network.sh writes generated/network.env.
NODE_COUNT=3
BLOCK_REWARD_SATS=5000000000
HALVING_INTERVAL=210000
BLOCK_INTERVAL=60
AUTO_MINE=yes
MAX_SAFE_NODES=20
LOCALNET_SUBNET=172.28.239.0/24
RPC_HOST_PORT_BASE=7041
# First host port publishing node P2P for peers outside Docker (node i = base+i-1).
P2P_HOST_PORT_BASE=7142
